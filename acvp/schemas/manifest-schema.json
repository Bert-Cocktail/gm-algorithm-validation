{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gm-validation/acvp-manifest.schema.json",
  "title": "Local ACVP request manifest",
  "type": "object",
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "requestDirectory": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "properties": {
        "files": {"type": "integer", "minimum": 1},
        "tests": {"type": "integer", "minimum": 1}
      },
      "required": ["files", "tests"],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "file": {"type": "string", "pattern": ".*-request\\.json$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "vsId": {"type": "integer", "minimum": 0},
          "algorithm": {"type": "string", "minLength": 1},
          "tests": {"type": "integer", "minimum": 1}
        },
        "required": ["file", "sha256", "bytes", "vsId", "algorithm", "tests"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "generatedAt", "requestDirectory", "summary", "files"],
  "additionalProperties": false
}
