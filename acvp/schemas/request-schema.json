{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gm-validation/acvp-request.schema.json",
  "title": "Local ACVP-style request envelope",
  "type": "array",
  "minItems": 2,
  "maxItems": 2,
  "prefixItems": [
    {
      "type": "object",
      "properties": {"acvVersion": {"const": "1.0"}},
      "required": ["acvVersion"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "vsId": {"type": "integer", "minimum": 0},
        "algorithm": {
          "enum": ["SM3", "HMAC-SM3", "SM4", "SM4-CTR-HMAC-SM3"]
        },
        "testGroups": {"type": "array", "minItems": 1}
      },
      "required": ["vsId", "algorithm", "testGroups"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"algorithm": {"const": "SM3"}}},
          "then": {"properties": {"testGroups": {"items": {"$ref": "#/$defs/sm3Group"}}}}
        },
        {
          "if": {"properties": {"algorithm": {"const": "HMAC-SM3"}}},
          "then": {"properties": {"testGroups": {"items": {"$ref": "#/$defs/hmacGroup"}}}}
        },
        {
          "if": {"properties": {"algorithm": {"const": "SM4"}}},
          "then": {"properties": {"testGroups": {"items": {"$ref": "#/$defs/sm4Group"}}}}
        },
        {
          "if": {"properties": {"algorithm": {"const": "SM4-CTR-HMAC-SM3"}}},
          "then": {"properties": {"testGroups": {"items": {"$ref": "#/$defs/authGroup"}}}}
        }
      ]
    }
  ],
  "$defs": {
    "hex": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{2})*$"},
    "positiveId": {"type": "integer", "minimum": 0},
    "sm3Group": {
      "type": "object",
      "properties": {
        "tgId": {"$ref": "#/$defs/positiveId"},
        "testType": {"const": "AFT"},
        "tests": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "tcId": {"$ref": "#/$defs/positiveId"},
              "msg": {"$ref": "#/$defs/hex"},
              "msgLen": {"type": "integer", "minimum": 0, "maximum": 1048576, "multipleOf": 8}
            },
            "required": ["tcId", "msg", "msgLen"],
            "additionalProperties": false
          }
        }
      },
      "required": ["tgId", "testType", "tests"],
      "additionalProperties": false
    },
    "hmacGroup": {
      "type": "object",
      "properties": {
        "tgId": {"$ref": "#/$defs/positiveId"},
        "testType": {"const": "AFT"},
        "keyLen": {"type": "integer", "minimum": 8, "maximum": 4096, "multipleOf": 8},
        "macLen": {"const": 256},
        "tests": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "tcId": {"$ref": "#/$defs/positiveId"},
              "key": {"$ref": "#/$defs/hex"},
              "msg": {"$ref": "#/$defs/hex"},
              "msgLen": {"type": "integer", "minimum": 0, "maximum": 1048576, "multipleOf": 8}
            },
            "required": ["tcId", "key", "msg", "msgLen"],
            "additionalProperties": false
          }
        }
      },
      "required": ["tgId", "testType", "keyLen", "macLen", "tests"],
      "additionalProperties": false
    },
    "sm4Group": {
      "type": "object",
      "properties": {
        "tgId": {"$ref": "#/$defs/positiveId"},
        "testType": {"const": "AFT"},
        "direction": {"enum": ["encrypt", "decrypt"]},
        "keyLen": {"const": 128},
        "mode": {"enum": ["ECB", "CBC", "CTR"]},
        "tests": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "tcId": {"$ref": "#/$defs/positiveId"},
              "key": {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"},
              "iv": {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"},
              "pt": {"$ref": "#/$defs/hex"},
              "ct": {"$ref": "#/$defs/hex"}
            },
            "required": ["tcId", "key"],
            "additionalProperties": false
          }
        }
      },
      "required": ["tgId", "testType", "direction", "keyLen", "mode", "tests"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"direction": {"const": "encrypt"}}},
          "then": {"properties": {"tests": {"items": {"required": ["pt"]}}}},
          "else": {"properties": {"tests": {"items": {"required": ["ct"]}}}}
        },
        {
          "if": {"properties": {"mode": {"enum": ["CBC", "CTR"]}}},
          "then": {"properties": {"tests": {"items": {"required": ["iv"]}}}}
        }
      ]
    },
    "authGroup": {
      "type": "object",
      "properties": {
        "tgId": {"$ref": "#/$defs/positiveId"},
        "testType": {"const": "AFT"},
        "direction": {"const": "encrypt"},
        "sm4KeyLen": {"const": 128},
        "hmacKeyLen": {"const": 256},
        "tagLen": {"const": 256},
        "tests": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "tcId": {"$ref": "#/$defs/positiveId"},
              "sm4Key": {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"},
              "hmacKey": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
              "iv": {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"},
              "pt": {"$ref": "#/$defs/hex"}
            },
            "required": ["tcId", "sm4Key", "hmacKey", "iv", "pt"],
            "additionalProperties": false
          }
        }
      },
      "required": ["tgId", "testType", "direction", "sm4KeyLen", "hmacKeyLen", "tagLen", "tests"],
      "additionalProperties": false
    }
  }
}
